# PostgreSQL connection string. Required by the api and the migration runner.
DATABASE_URL=postgres://user:password@localhost:5432/turborepo

# Tests only (pnpm test / verify / test:e2e); the api never reads it. A separate database whose
# name must end in _test: tests drop and truncate everything in it.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/turborepo_test

# The public origin. Defaults to Vite's http://localhost:5173 in dev.
# Production (required, https): APP_ORIGIN=https://app.example.com
# APP_ORIGIN=

# Auth — Google OAuth 2.0 (OIDC) client.
# Provision at: https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Application type: "Web application"
#   → Authorized redirect URI: <APP_ORIGIN>/api/auth/google/callback, i.e.
#     http://localhost:5173/api/auth/google/callback and your production equivalent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth — token signing secrets. Each must be at least 32 chars. Use independent values.
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Auth — signs the short-lived oauth_state cookie. Generate with: openssl rand -base64 32
COOKIE_SECRET=

# Audio storage: an S3-compatible bucket, required to boot. Use a separate bucket and access
# key for dev and for production. For DigitalOcean Spaces: create the Space and an access key
# limited to it at https://cloud.digitalocean.com/spaces, then set the Space's CORS to allow
# PUT, GET and HEAD from APP_ORIGIN (http://localhost:5173 for the dev bucket) with the
# Content-Type header. Tests don't use these; they run against an in-memory bucket.
S3_ENDPOINT=https://ams3.digitaloceanspaces.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1   # Spaces ignores it, but the SDK needs a value

# Optional:
# PORT=3000        # the api's port; also the localhost port compose publishes on the VPS
# LOG_LEVEL=info
